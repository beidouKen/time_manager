# DeepSeek LLM Agent config
# Copy this file to .env, fill in your real API key, then restart the dev server.
#
# Notes:
# - Do not commit .env. It is ignored by .gitignore.
# - Leave VITE_DEEPSEEK_API_KEY empty to disable the LLM path and use rule fallback.

# DeepSeek OpenAI-compatible base URL
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model name
VITE_DEEPSEEK_MODEL=deepseek-v4-pro

# Real API key goes in .env, not in this example file.
VITE_DEEPSEEK_API_KEY=

# true enables LLM Agent; false or unset uses rule IntentParser only.
VITE_LLM_AGENT_ENABLED=true
