# Time Manager — LLM Agent 配置
# 复制此文件为 .env，填入真实 API key，重启 dev server 生效。
#
# 注意：
# - 不要提交 .env（已在 .gitignore 中）
# - V3.7 行为说明（VITE_LLM_AGENT_ENABLED + VITE_DEEPSEEK_API_KEY 组合）：
#
#   | ENABLED | API_KEY | 行为 |
#   |---------|---------|------|
#   | true    | 已填    | LLM-first planner（time_management 走 DeepSeek） |
#   | true    | 空/缺   | 自动降级到规则路径，UI 不崩溃，DeepSeekClient.isAvailable()=false |
#   | false   | 任意    | 只走规则路径，不创建 LLM client |
#   | 未设置  | 任意    | 等价 false |
#
# 关键保证：即使 API key 缺失或 LLM 不可用，应用也不会崩溃。
# CompositePlanner 会透明降级到 ActionPlanner 规则路径并记录 errorKind。

# DeepSeek OpenAI 兼容接口地址
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
VITE_DEEPSEEK_MODEL=deepseek-v4-pro

# 真实 API key 填入 .env，不要填入此示例文件
VITE_DEEPSEEK_API_KEY=

# true 启用 LLM-first planner；false 或未设置走规则路径
VITE_LLM_AGENT_ENABLED=true
