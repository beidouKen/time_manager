# DeepSeek LLM Agent 配置
# 复制此文件为 .env，填入真实 API Key 后重启开发服务器
#
# 注意：
#   - .env 文件不应提交到版本控制（已在 .gitignore 中排除）
#   - API Key 为空时应用仍可正常启动，Chat 会提示未配置

# DeepSeek API 基础地址（OpenAI-compatible）
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称
VITE_DEEPSEEK_MODEL=deepseek-v4-pro

# DeepSeek API Key（留空则禁用 LLM Agent，fallback 到规则解析）
VITE_DEEPSEEK_API_KEY=

# 是否启用 LLM Agent（true=启用，false 或未设置=使用规则 IntentParser）
VITE_LLM_AGENT_ENABLED=true
